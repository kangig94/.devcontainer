# Shell and GNU make compatible dependency profile.
#
# Isaac Lab v3.0.0-EA pins `isaacsim[all,extscache]==6.1.0.0` and requires
# torch>=2.11 (pyproject.toml:41-43,182). Torch 2.11 has no cu128 wheels —
# PyTorch ships it on cu129/cu130 only — so this profile moves to cu130.
# Isaac Lab itself declares both pytorch-cu128 and pytorch-cu130 indexes
# (pyproject.toml:375-382), and only cu130 can satisfy torch>=2.11.
PYTHON_VERSION=3.12
TORCH_VERSION=2.11.0
CUDA_TAG=cu130
UBUNTU_VERSION=24.04
CUDA_TOOLKIT_VERSION=13-0
ISAACSIM_VERSION=6.1.0
ISAAC_ASSET_ROOT=/data/isaacsim_assets/Assets/Isaac/6.1
